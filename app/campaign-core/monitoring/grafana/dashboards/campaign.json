    {
      "id": 17,
      "title": "Bridge Redis 호출 지연 (앱별 평균)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * sum by (instance, operation) (rate(bridge_redis_duration_seconds_sum[1m])) / sum by (instance, operation) (rate(bridge_redis_duration_seconds_count[1m]))",
          "legendFormat": "{{instance}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "클라이언트 호출 시간. 연결/네트워크/직렬화/Redis 대기를 포함하며 Redis 서버 실행 시간만을 의미하지 않는다."
    },
